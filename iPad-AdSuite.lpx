#!name = 常用 App 去广告
#!desc = 精确广告域名及购物、生活、内容应用的开屏与信息流规则。已包含轻量版和内嵌版。复写需要 HTTPS 解密；无远程脚本。
#!author = lingjieheti
#!loon_version = 3.5.1(978)
#!date = 2026-11-21

[Rule]
# Google AdMob / Ad Manager
DOMAIN,googleads.g.doubleclick.net,REJECT
DOMAIN,pubads.g.doubleclick.net,REJECT
DOMAIN,securepubads.g.doubleclick.net,REJECT
DOMAIN,pagead2.googlesyndication.com,REJECT

# 百度广告
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,adscdn.baidu.com,REJECT
DOMAIN,mobads-pre-config.cdn.bcebos.com,REJECT

# 腾讯广告与腾讯音乐
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,adsmind.apdcdn.tc.qq.com,REJECT
DOMAIN,ad.tencentmusic.com,REJECT
DOMAIN,tmead.y.qq.com,REJECT

# 字节跳动与穿山甲
DOMAIN,ad.zijieapi.com,REJECT
DOMAIN,pangolin.snssdk.com,REJECT
DOMAIN,pangolin-hl.snssdk.com,REJECT
DOMAIN,pangolin-lf.snssdk.com,REJECT
DOMAIN,pangolin-lq.snssdk.com,REJECT

# 快手广告素材
DOMAIN,ali-ad.a.yximgs.com,REJECT
DOMAIN,tx-ad.a.yximgs.com,REJECT
DOMAIN,hw-ot-ad.a.yximgs.com,REJECT

# 微博与 WPS 广告接口
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,api-ad-adapter.wps.com,REJECT

# 京东京媒广告
DOMAIN,dsp-x.jd.com,REJECT

# 美团
DOMAIN,mads.meituan.com,REJECT

# 网易云音乐
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,admusicpic.music.126.net,REJECT

# QQ音乐
DOMAIN,adcdn.tencentmusic.com,REJECT
DOMAIN,adcdn6.tencentmusic.com,REJECT

# 腾讯视频
DOMAIN,adsmind.gdtimg.com,REJECT

# 优酷
DOMAIN,adx-open-service.youku.com,REJECT
DOMAIN,yk-ssp.ad.youku.com,REJECT

# 爱奇艺
DOMAIN,ef-dongfeng.tanx.com,REJECT

# 微博
DOMAIN,bootpreload.uve.weibo.com,REJECT
DOMAIN,adimg.uve.weibo.com,REJECT

# 小红书
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT

# 铁路12306
DOMAIN,ad.12306.cn,REJECT

[Rewrite]
# 微信文章的独立广告接口及阅读互动接口。只有广告列表和计数都存在时才清空，保留阅读数和评论。
response if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(?:getappmsgad|getappmsgext)(?:\?|$)/ && ${response.status} == 200 then response.json.jq(`def ok: type == "object" and ((has("ret") | not) or .ret == 0); if ok and (.base_resp == null or (.base_resp | ok)) and (.appmsgstat == null or (.appmsgstat | ok)) and (.advertisement_info | type) == "array" and (.advertisement_num | type) == "number" and .advertisement_num >= 0 then .advertisement_info = [] | .advertisement_num = 0 else . end`)

# 哔哩哔哩 App 首页。卡片类型和去向同时匹配才剔除，混排横幅仅移除广告子项。
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ad_card: ((.card_type | IN("cm_v1", "cm_v2")) and (.card_goto | IN("ad_web_s", "ad_av", "ad_web_gif"))) or (.card_type == "cm_v2" and (.card_goto | IN("ad_player", "ad_inline_3d", "ad_inline_eggs", "ad_inline_live"))) or (.card_type == "cm_double_v9" and .card_goto == "ad_inline_av"); def clean_card: if type != "object" then . elif ad_card then empty elif (.card_type | IN("banner_ipad_v8", "banner_v8")) and .card_goto == "banner" and (.banner_item | type) == "array" then .banner_item |= map(select(if type == "object" then (.type | IN("ad", "ad_inline") | not) else true end)) else . end; if type == "object" and .code == 0 and (.data | type) == "object" and (.data.items | type) == "array" then .data.items |= map(clean_card) else . end`)

# 哔哩哔哩网页首页。该接口使用单数 item；普通视频即使带广告位元数据也保留。
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/web-interface\/wbi\/index\/top\/feed\/rcmd(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .code == 0 and (.data | type) == "object" and (.data.item | type) == "array" then .data.item |= map(select(if type == "object" then .goto != "ad" else true end)) else . end`)

# 京东开屏图（明文 start）
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:(?!functionId=)[^&#]*&)*functionId=start(?:&(?!functionId=)[^&#]*)*$/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ok: type == "object" and ((has("code") | not) or .code == 0 or .code == "0") and ((has("success") | not) or .success == true) and ((has("errorCode") | not) or .errorCode == 0 or .errorCode == "0"); def clean: if ok and (.images | type) == "array" and (.showTimesDaily | type) == "number" and .showTimesDaily >= 0 then .images = [] | .showTimesDaily = 0 else . end; if ok then (if has("data") then (if (.code == 0 or .code == "0") and (.data | type) == "object" then .data |= clean else . end) else clean end) else . end`)

# 京东首页两种悬浮推广（明文 welcomeHome）
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?(?:(?!functionId=)[^&#]*&)*functionId=welcomeHome(?:&(?!functionId=)[^&#]*)*$/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ok: type == "object" and ((has("code") | not) or .code == 0 or .code == "0") and ((has("success") | not) or .success == true) and ((has("errorCode") | not) or .errorCode == 0 or .errorCode == "0"); def clean: if ok and (.floorList | type) == "array" then .floorList |= map(select(if type == "object" then (.type != "bottomXview" and .type != "photoCeiling") else true end)) else . end; if ok then (if has("data") then (if (.code == 0 or .code == "0") and (.data | type) == "object" then .data |= clean else . end) else clean end) else . end`)

# 京东竞价广告（仅 bdsp-x 的 /adx/ 路径）
request if ${url} ~= /^https:\/\/bdsp-x\.jd\.com\/adx\// then reject(404)

# 淘宝 · 开屏广告素材
response if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:\/1\.0\/?)?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def mtop_ok($name): type == "object" and .api == $name and (.v == null or .v == "1.0") and (.ret | type) == "array" and (.ret | length) > 0 and all(.ret[]; type == "string" and (. == "SUCCESS" or startswith("SUCCESS::"))); def sections: try .data.containers.splash_home_base.base.sections catch null; def slots: try .bizData["taobao-splash"].data catch null; def material_url: type == "string" and (startswith("https://") or startswith("http://") or startswith("//")); def is_creative: type == "object" and ((.imgUrl | material_url) or (.videoUrl | material_url)); if mtop_ok("mtop.taobao.wireless.home.splash.awesome.get") and (sections | type) == "array" then .data.containers.splash_home_base.base.sections |= map(if (slots | type) == "array" then .bizData["taobao-splash"].data |= map(select(is_creative | not)) else . end) else . end`)

# 菜鸟 · 专用广告投放接口
response if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad(?:\/1\.0\/?)?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def mtop_ok($name): type == "object" and .api == $name and (.v == null or .v == "1.0") and (.ret | type) == "array" and (.ret | length) > 0 and all(.ret[]; type == "string" and (. == "SUCCESS" or startswith("SUCCESS::"))); if mtop_ok("mtop.cainiao.adx.flyad.getad") and (.data | type) == "object" then .data = {} else . end`)

# 抖音 · 推荐流中带明确广告标记的视频
response if ${url} ~= /^https:\/\/(?:(?:api3-(?:core|normal)-c|api)\.amemv\.com|aweme\.snssdk\.com)\/aweme\/v[12]\/feed\/?(?!\?(?:[^&#]*&)*(?:aweme_ids?(?:[=&#]|$)|[^=&#]*%))(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def usable_id: (type == "string" or type == "number") and (tostring | test("^[1-9][0-9]*\\z")); def ad_item: type == "object" and (.is_ads == true or .is_ads == 1); def content_item: type == "object" and ((.aweme_id | usable_id) or (.room_id | usable_id) or (.live_room | type == "object" and ((.id | usable_id) or (.id_str | usable_id)))); if type == "object" and .status_code == 0 and ((has("error_code") | not) or .error_code == 0) and ((has("success") | not) or .success == true) and .systemError != true and .error == null and (.aweme_list | type) == "array" and (.aweme_list | length) > 1 and any(.aweme_list[]; ad_item) and any(.aweme_list[]; (ad_item | not) and content_item) then .aweme_list |= map(select(ad_item | not)) else . end`)

# 抖音 · 已知开屏广告路径（候选）
request if ${url} ~= /^https:\/\/(?:(?:api3-(?:core|normal)-c|api)\.amemv\.com|aweme\.snssdk\.com)\/api\/ad\/(?:v1\/splash\/stock|v16\/splash\/preload|splash\/stock\/realtime\/v1[45]|splash\/aweme\/v15)\/?(?:\?|$)/ then reject(404)

# 微博 · 关注时间线中的广告博文
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:friends\/timeline|unread_friends_timeline)\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ad_post: type == "object" and (.is_ad == 1 or .mblogtypename == "广告"); if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.statuses | type) == "array" then .statuses |= map(select(ad_post | not)) else . end`)

# 微博 · 首页和推荐中的广告博文
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline(?:_unread|_hot)?\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ad_post: type == "object" and (.is_ad == 1 or .mblogtypename == "广告"); if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.items | type) == "array" then .items |= map(select(if type == "object" then ((if .data != null then .data else .status end) | ad_post | not) else true end)) else . end`)

# 微博轻享版 · 独立品牌广告列表
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/ad\/weibointl\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.data | type) == "array" then .data = [] else . end`)

# 酷安 · 首页的赞助卡片
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/(?:dataList|indexV8)\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.data | type) == "array" then .data |= map(select(if type == "object" then .entityTemplate != "sponsorCard" else true end)) else . end`)

# 美团 · 主 App 启动页的开屏素材数组
response if ${url} ~= /^https:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def clear_area: if type == "object" and (.startupPicArea | type) == "array" then .startupPicArea = [] else . end; def clear_holder: if type == "object" then (select(has("resource")) | .resource) |= clear_area | (select(has("resourcesMap")) | .resourcesMap) |= clear_area else . end; if type == "object" and ((has("code") | not) or .code == 0 or .code == 200) and ((has("success") | not) or .success == true) and .error == null and .systemError != true then clear_holder | (select(has("data")) | .data) |= clear_holder else . end`)

# 美团外卖 · 混合启动配置中的广告数组
response if ${url} ~= /^https:\/\/wmapi\.meituan\.com\/api\/v7\/loadInfo\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and ((has("code") | not) or .code == 0 or .code == 200) and ((has("success") | not) or .success == true) and .error == null and .systemError != true and (.data | type) == "object" and (.data.startpicture | type) == "object" and (.data.startpicture.ad | type) == "array" then .data.startpicture.ad = [] else . end`)

# 美团外卖 · 两个独立开屏广告接口
request if ${url} ~= /^https:\/\/wmapi\.meituan\.com\/api\/v7\/(?:openscreen|startpicture)\/?(?:\?|$)/ then reject_dict(200)

# 美团 · p0/p1 图床的广告联盟素材
request if ${url} ~= /^https:\/\/p[01]\.meituan\.net\/adunion\/[^?#\/]+(?:\/[^?#\/]+)*(?:\?|$)/ then reject_img(200)

# 美团 · 图片服务器的品牌和联盟广告素材
request if ${url} ~= /^https:\/\/img\.meituan\.net\/(?:bizad\/bizad_brandCpt_[0-9]+\.jpg|adunion\/(?:[^?#\/]+\/)*[^?#\/]+\.(?:gif|jpg)\.webp)(?:\?|$)/ then reject_img(200)

# 美团餐饮微信小程序 · 带广告单元标识的广告位
response if ${url} ~= /^https:\/\/rms\.meituan\.com\/api\/v1\/rmsmina\/c\/queryWechatAdvertisement\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .code == 200 and .success == true and .systemError != true and .error == null and (.data | type) == "object" and (.data.adSiteList | type) == "array" then .data.adSiteList |= map(select(if type == "object" and (.adSiteId | type) == "string" then (.adSiteId | test("^adunit-[a-zA-Z0-9_-]+$") | not) else true end)) else . end`)

# 拼多多 · 开屏广告配置
request if ${url} ~= /^https:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash\/?(?:\?|$)/ then reject(404)

# 闲鱼 · 两个开屏广告接口
request if ${url} ~= /^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.(?:async\.)?ads(?:\/[0-9]+\.[0-9]+)?\/?(?:\?|$)/ then reject_dict(200)

# 大众点评 · 开屏配置
request if ${url} ~= /^https:\/\/mapi\.dianping\.com\/mapi\/operating\/loadsplashconfig\/?(?:\?|$)/ then reject(404)

# 高德地图 · 启动广告配置
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\/?(?:\?|$)/ then reject_dict(200)

# 高德地图 · 阿里妈妈开屏广告
request if ${url} ~= /^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt\/?(?:\?|$)/ then reject(404)

# 小红书 · 首页带非空广告信息的推广条目
response if ${url} ~= /^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v[0-9]+\/homefeed\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and ((.code == 0 and .success != false) or ((has("code") | not) and .success == true)) and (.data | type) == "array" then .data |= map(select(if type == "object" and (.ads_info | type) == "object" then (.ads_info | length) == 0 else true end)) else . end`)

# 知乎 · 首页推荐中的 feed_advert 广告卡
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/topstory\/recommend\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and (.data | type) == "array" then .data |= map(select(if type == "object" then .type != "feed_advert" else true end)) else . end`)

[MitM]
hostname = mp.weixin.qq.com, app.bilibili.com, api.bilibili.com, api.m.jd.com, bdsp-x.jd.com, guide-acs.m.taobao.com, api3-core-c.amemv.com, api3-normal-c.amemv.com, api.amemv.com, aweme.snssdk.com, api.weibo.cn, api.coolapk.com, mop.meituan.com, wmapi.meituan.com, p0.meituan.net, p1.meituan.net, img.meituan.net, rms.meituan.com, api.pinduoduo.com, api.yangkeduo.com, acs.m.goofish.com, mapi.dianping.com, m5.amap.com, amap-aos-info-nogw.amap.com, edith.xiaohongshu.com, rec.xiaohongshu.com, api.zhihu.com
