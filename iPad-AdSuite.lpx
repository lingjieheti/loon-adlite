[Rewrite]

# 掌上京彩 · 静态广告目录中的图片
request if ${url} ~= /^https:\/\/cdn-xyk-app\.bankofbeijing\.com\.cn\/cdn\/resource\/image\/advertise\/(?:[A-Za-z0-9_-]+\/)*[A-Za-z0-9_.-]+\.(?:jpe?g|png|gif|webp)(?:\?|$)/ then reject_img(200)

# 微信公众号 · 只拦已知广告可见位置和停留时间的图片信标
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/ad_report\?action=see_report&aid=[A-Za-z0-9_-]+&tid=[A-Za-z0-9_-]+&(?:seepos=[1-3]&report_type=0|seetime=(?:500|1000|2000)&report_type=1)$/ && ${request.method} == "GET" then reject_img(200)

# 微信公众号 · 广告点击时间、曝光时长等附加上报
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/advertisement_report\?action=extra_report(?:&extra_data=[^&#;]+&__biz=[A-Za-z0-9_%+=.-]+)?(?:&(?:uin|key|pass_ticket|wxtoken|devicetype|clientversion|appmsg_token|x5|f)=[^&#;]*)*$/ then reject_dict(200)

# 微信公众号 · 为具备完整曝光标识的 GET 在本机返回成功，避免客户端重试
response if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/advertisement_report\?report_type=1&tid=[A-Za-z0-9_-]+&aid=[A-Za-z0-9_-]+(?:&gh_id=[^&#;]*)?&adver_group_id=[^&#;]*&apurl=[^&#;]+(?:&(?:__biz|ascene|pos_type|exp_id|exp_value|r|ad_sign_data|ad_sign_k1|ad_sign_k2|ad_sign_md5|uin|key|pass_ticket|wxtoken|devicetype|clientversion|appmsg_token|x5|f)=[^&#;]*)*$/ && ${request.method} == "GET" then response.body.mock("json", `{"ret":0}`, 200)

# 微信文章的独立广告接口及阅读互动接口。只处理声明为 JSON 且含广告列表和计数的响应，保留阅读数和评论。
response if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(?:getappmsgad|getappmsgext)(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ok: type == "object" and ((has("ret") | not) or .ret == 0); if ok and (.base_resp == null or (.base_resp | ok)) and (.appmsgstat == null or (.appmsgstat | ok)) and (.advertisement_info | type) == "array" and (.advertisement_num | type) == "number" and .advertisement_num >= 0 then .advertisement_info = [] | .advertisement_num = 0 else . end`)

# 哔哩哔哩 App 首页。卡片类型和去向同时匹配才剔除，混排横幅仅移除广告子项。
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def banner_ad: type == "object" and (.type == "ad" or .type == "ad_inline"); def clean_card: if type != "object" then . else .card_type as $kind | if $kind == "cm_v1" or $kind == "cm_v2" then .card_goto as $goto | select((($goto | IN("ad_web_s", "ad_av", "ad_web_gif")) or ($kind == "cm_v2" and ($goto | IN("ad_player", "ad_inline_3d", "ad_inline_eggs", "ad_inline_live")))) | not) elif $kind == "cm_double_v9" then select(.card_goto != "ad_inline_av") elif ($kind == "banner_v8" or $kind == "banner_ipad_v8") and .card_goto == "banner" and (.banner_item | type) == "array" and any(.banner_item[]; banner_ad) then .banner_item |= map(select(banner_ad | not)) else . end end; if type == "object" and .code == 0 and .error == null and ((has("success") | not) or .success == true) and (.data | type) == "object" and (.data.items | type) == "array" then .data.items |= map(clean_card) else . end`)

# 哔哩哔哩 App 开屏。只去同时带两种商业标记的素材，按同一响应里的已知素材 ID 清理对应排期和缓存引用。
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def material_id: type == "number" and . >= 1 and . <= 2147483647 and . == floor; def id_key: (if type == "string" then (tonumber? // .) else . end) | if material_id then floor | tostring else tostring end; def ad: type == "object" and .is_ad == true and .cm_mark == 1 and (.id | material_id); if type == "object" and .code == 0 and .error == null and ((has("success") | not) or .success == true) and (.data | type) == "object" and (.data.list | type) == "array" and any(.data.list[]; ad) then (reduce (.data.list[] | objects | select(.id | type == "string" or type == "number")) as $row ({}; ($row.id | id_key) as $key | .[$key] = (.[$key] != false and ($row | ad)))) as $ad_ids | def removed: material_id and (id_key as $key | $ad_ids[$key] == true); .data.list |= map(select(ad | not)) | if (.data.show | type) == "array" then .data.show |= map(select((type == "object" and (.id | removed)) | not)) else . end | if (.data.keep_ids | type) == "array" then .data.keep_ids |= map(select(removed | not)) else . end else . end`)

# 京东 · 商品搜索广告的展示像素
request if ${url} ~= /^https:\/\/im-x\.jd\.com\/dsp\/np\?log=[A-Za-z0-9_-]+&v=404$/ && ${request.method} == "GET" then reject_img(200)

# 京东竞价广告（仅 bdsp-x 的 /adx/ 路径）
request if ${url} ~= /^https:\/\/bdsp-x\.jd\.com\/adx\// then reject(404)

# 淘宝移动首页 · 轮播广告的 JSONP 展示回调
request if ${url} ~= /^https:\/\/ifs\.tanx\.com\/display_ifs\?i=(?:[A-Za-z0-9._+-]|%[0-9A-Fa-f]{2})+&p=(?:[A-Za-z0-9]|%2[BbFf]){34}%3[Dd]%3[Dd]&callback=__jp(?:0|[1-9][0-9]*)$/ && ${request.method} == "GET" then reject(404)

# 抖音 · 推荐流中带明确广告标记的视频
response if ${url} ~= /^https:\/\/(?:api3-(?:core|normal)-c|api)\.amemv\.com\/aweme\/v[12]\/feed\/?(?!\?(?:[^&#]*&)*(?:aweme_ids?(?:[=&#]|$)|[^=&#]*%))(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def usable_id: (type == "string" or type == "number") and (tostring | test("^[1-9][0-9]*\\z")); def ad_item: type == "object" and (.is_ads == true or .is_ads == 1); def content_item: type == "object" and ((.aweme_id | usable_id) or (.room_id | usable_id) or (.live_room | type == "object" and ((.id | usable_id) or (.id_str | usable_id)))); if type == "object" and .status_code == 0 and ((has("error_code") | not) or .error_code == 0) and ((has("success") | not) or .success == true) and .systemError != true and .error == null and (.aweme_list | type) == "array" and (.aweme_list | length) > 1 and any(.aweme_list[]; ad_item) and any(.aweme_list[]; (ad_item | not) and content_item) then .aweme_list |= map(select(ad_item | not)) else . end`)

# 抖音 · 已知开屏广告路径（候选）
request if ${url} ~= /^https:\/\/(?:api3-(?:core|normal)-c|api)\.amemv\.com\/api\/ad\/(?:v1\/splash\/stock|v16\/splash\/preload|splash\/stock\/realtime\/v1[45]|splash\/aweme\/v15)\/?(?:\?|$)/ then reject(404)

# 微博 · 关注时间线中的广告博文
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:friends\/timeline|unread_friends_timeline)\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ad_post: type == "object" and (.is_ad == 1 or .mblogtypename == "广告"); if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.statuses | type) == "array" then .statuses |= map(select(ad_post | not)) else . end`)

# 微博 · 首页和推荐中的广告博文
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline(?:_unread|_hot)?\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ad_post: type == "object" and (.is_ad == 1 or .mblogtypename == "广告"); if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.items | type) == "array" then .items |= map(select(if type == "object" then ((if .data != null then .data else .status end) | ad_post | not) else true end)) else . end`)

# 微博轻享版 · 独立品牌广告列表
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/ad\/weibointl\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.data | type) == "array" then .data = [] else . end`)

# 酷安 · 首页的赞助卡片
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/(?:dataList|indexV8)\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and ((has("error_code") | not) or .error_code == 0) and ((has("errno") | not) or .errno == 0) and (.errmsg == null or .errmsg == "") and ((has("success") | not) or .success == true) and ((has("ok") | not) or .ok == 1 or .ok == true) and ((has("status") | not) or .status == 0 or .status == 1) and (.data | type) == "array" then .data |= map(select(if type == "object" then .entityTemplate != "sponsorCard" else true end)) else . end`)

# 美团 · 主 App 启动页的开屏素材数组
response if ${url} ~= /^https:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def clear_area: if type == "object" and (.startupPicArea | type) == "array" then .startupPicArea = [] else . end; def clear_holder: if type == "object" then (select(has("resource")) | .resource) |= clear_area | (select(has("resourcesMap")) | .resourcesMap) |= clear_area else . end; if type == "object" and ((has("code") | not) or .code == 0 or .code == 200) and ((has("success") | not) or .success == true) and .error == null and .systemError != true then clear_holder | (select(has("data")) | .data) |= clear_holder else . end`)

# 美团外卖 · 混合启动配置中的广告数组
response if ${url} ~= /^https:\/\/wmapi\.meituan\.com\/api\/v7\/loadInfo\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and ((has("code") | not) or .code == 0 or .code == 200) and ((has("success") | not) or .success == true) and .error == null and .systemError != true and (.data | type) == "object" and (.data.startpicture | type) == "object" and (.data.startpicture.ad | type) == "array" then .data.startpicture.ad = [] else . end`)

# 美团外卖 · 两个独立开屏广告接口
request if ${url} ~= /^https:\/\/wmapi\.meituan\.com\/api\/v7\/(?:openscreen|startpicture)\/?(?:\?|$)/ then reject_dict(200)

# 美团餐饮微信小程序 · 带广告单元标识的广告位
response if ${url} ~= /^https:\/\/rms\.meituan\.com\/api\/v1\/rmsmina\/c\/queryWechatAdvertisement\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def no_error($key): (has($key) | not) or .[$key] == false; if type == "object" and .code == 200 and .success == true and no_error("systemError") and no_error("badRequest") and no_error("notFound") and no_error("conflict") and .error == null and (.data | type) == "object" and (.data.adSiteList | type) == "array" then .data.adSiteList |= map(select(if type == "object" and (.adSiteId | type) == "string" then (.adSiteId | test("\\Aadunit-[a-zA-Z0-9_-]+\\z") | not) else true end)) else . end`)

# BOSS 直聘 · 启动广告
request if ${url} ~= /^https:\/\/api-ios\.zhipin\.com\/api\/zpCommon\/user\/startupAd\/?(?:\?|$)/ then reject_dict(200)

# 拼多多广告联盟 · 仅处理浏览器标记为图片的展示回调
request if ${url} ~= /^https:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_union(?:\?[^#\s]*)?$/ && ${request.method} == "GET" && ${request.header['Sec-Fetch-Dest']} == "image" then reject_img(200)

# 拼多多 · 搜索结果中带商品、商家和广告创意标识的付费商品卡
response if ${url} ~= /^https:\/\/api\.pinduoduo\.com(?::443)?\/search\/?\?(?:(?!(?i:q|cb|callback|jsonp|jsoncallback)=)[A-Za-z0-9_-]+=[^&#;]*&)*q=[^&#;]+(?:&(?!(?i:q|cb|callback|jsonp|jsoncallback)=)[A-Za-z0-9_-]+=[^&#;]*)*$/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def id: type == "number" and . > 0 and . <= 9007199254740991 and floor == .; def product: type == "object" and (.goods_id | id) and (.goods_name | type == "string" and length > 0); def paid: product and (.ad | type) == "object" and (.ad.goods_id | id) and .goods_id == .ad.goods_id and (.ad.creative_id | id) and (.ad.mall_id | id) and (.ad.ocpcBid | type == "number" and . > 0); if type == "object" and ((has("success") | not) or .success == true) and ((has("code") | not) or .code == 0 or .code == 200) and (.error_code == null or .error_code == 0) and (.error_msg == null or .error_msg == "") and .error == null and (.empty_reason == null or .empty_reason == 0) and (.flip | type) == "string" and (.items | type) == "array" and any(.items[]; paid) and any(.items[]; product and .ad == null) then .items |= map(select(paid | not)) else . end`)

# 拼多多 · 首页推荐模块中的明确广告标记
response if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub(?:\/refresh)?\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and ((has("success") | not) or .success == true) and ((has("code") | not) or .code == 0 or .code == 200) and (.error_code == null or .error_code == 0) and (.error_msg == null or .error_msg == "") and .error == null and (.result | type) == "object" and (.result.module_order | type) == "array" then .result.module_order |= map(select(if type == "object" then .module_name != "ad_module" else true end)) else . end`)

# 去哪儿 · 独立开屏广告请求
request if ${url} ~= /^https:\/\/homefront\.qunar\.com\/front\/splash\/ad(?:\?|$)/ then reject_dict(200)

# 高德地图 · 阿里妈妈开屏广告
request if ${url} ~= /^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt\/?(?:\?|$)/ then reject(404)

# 爱奇艺 · 首页明确标记的两类广告卡
response if ${url} ~= /^https:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and .stackTrace == null and ((has("code") | not) or .code == 0 or .code == "0") and ((has("success") | not) or .success == true) and (.cards | type) == "array" then .cards |= map(select(if type == "object" then .alias_name != "ad_mobile_flow" and .alias_name != "ad_trueview" else true end)) else . end`)

# 爱奇艺 · 搜索列表中的明确广告卡
response if ${url} ~= /^https:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/(?:hot_query_)?search(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def ad: .strategy_com_id as $id | ["ad_mobile_flow", "hot_query_search_top_ad", "search_mid_text_ad", "search_small_card_ad"] | index($id) != null; if type == "object" and .error == null and .stackTrace == null and ((has("code") | not) or .code == 0 or .code == "0") and ((has("success") | not) or .success == true) and (.cards | type) == "array" then .cards |= map(select(if type == "object" and (.strategy_com_id | type) == "string" then ad | not else true end)) else . end`)

# 爱奇艺 · 焦点图和内容卡中已核对的两种视频广告位
response if ${url} ~= /^https:\/\/t7z\.cupid\.iqiyi\.com\/mixer(?:\?(?:(?!(?i:cb|callback|jsonp|jsoncallback)(?:[=&]|$))[A-Za-z0-9_-]+(?:=[^&#;]*)?(?:&|$))*)?$/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`def roll_slot: type == "object" and .type == 0 and .duration == 0 and .startTime == 0 and (.adZoneId == "1000000000406" or .adZoneId == "1000000000822") and (.ads | type) == "array" and (.ads | length) > 0 and all(.ads[]; type == "object" and .templateType == "roll" and .creativeType == "roll" and .orderItemType == 11 and .timePosition == "1"); if type == "object" and .errorCode == 0 and .error == null and .serverError == "" and .midrollPoints == {} and (.adSlots | type) == "array" then .adSlots |= map(select(roll_slot | not)) else . end`)

# 小红书 · 首页带非空广告信息的推广条目
response if ${url} ~= /^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v[0-9]+\/homefeed\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and ((.code == 0 and ((has("success") | not) or .success == true)) or ((has("code") | not) and .success == true)) and (.data | type) == "array" then .data |= map(select(if type == "object" and (.ads_info | type) == "object" then (.ads_info | length) == 0 else true end)) else . end`)

# 知乎 · 首页推荐中的 feed_advert 广告卡
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/topstory\/recommend\/?(?:\?|$)/ && ${response.status} == 200 && ${response.header['Content-Type']} ~= /^application\/json\s*(?:;|$)/i then response.json.jq(`if type == "object" and .error == null and ((has("code") | not) or .code == 0) and ((has("success") | not) or .success == true) and (.data | type) == "array" then .data |= map(select(if type == "object" then .type != "feed_advert" else true end)) else . end`)

