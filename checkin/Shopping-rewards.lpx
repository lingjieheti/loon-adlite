#!name = 京东淘宝抖音 · 签到领券
#!desc = 每天一条本地提醒。轻点选择的官方入口，在前台签到或领取优惠。可选京东单券链接仅用于打开领取页。
#!author = lingjieheti
#!loon_version = 3.5.1(983)
#!homepage = https://github.com/lingjieheti/loon-adlite/blob/main/checkin/README.md

[Argument]
destination = select,"三平台清单","京东领券中心","京东指定优惠券","京东京豆签到","淘宝红包签到","淘宝淘金币","抖音商城领券",tag=轻点通知打开
coupon = input,tag=京东官方单券链接,desc=选择京东指定优惠券时填写 coupon.m.jd.com 的单券网址
hour = select,"0 9 * * *","0 12 * * *","0 20 * * *",tag=每日提醒时间,desc=设备当地时间 9 点、12 点或 20 点

[Script]
cron ${hour} then script("https://raw.githubusercontent.com/lingjieheti/loon-adlite/6c18f0edb49c6c7dc3968e2f97f8ed79fabf03e6/checkin/shopping-reminder.js", {${destination}, ${coupon}}) with tag="签到领券", timeout=5
